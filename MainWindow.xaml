<Window x:Class="CampusCafe.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campus Café Management Board" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="15,12" Margin="0,0,0,15">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CAMPUS CAFÉ" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text=" | Interactive Management Board" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <Button Content="Show All" Click="BtnShowAll_Click" HorizontalAlignment="Right" Width="80" Height="32" Background="#1E3A8A" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- MAIN TABBED NAVIGATION -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="Margin" Value="0,0,5,10"/>
                    <Setter Property="Foreground" Value="#475569"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" CornerRadius="6" Background="#E2E8F0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#0F172A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: MENU PRODUCTS -->
            <TabItem Header="📋 Menu Products">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: ADD PRODUCT FORM -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="+ Add Product" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                                <TextBlock Text="Product Name" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtProductName" Height="35" Padding="5" Margin="0,0,0,12"/>

                                <TextBlock Text="Category" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbCategory" Height="35" Padding="5" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Coffee" IsSelected="True"/>
                                    <ComboBoxItem Content="Non-Coffee"/>
                                    <ComboBoxItem Content="Tea &amp; Milk Tea"/>
                                    <ComboBoxItem Content="Chocolate"/>
                                </ComboBox>

                                <TextBlock Text="Price (PHP)" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtPrice" Height="35" Padding="5" Margin="0,0,0,12"/>

                                <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtDescription" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,15"/>

                                <CheckBox x:Name="ChkAvailable" Content="Available for Order" IsChecked="True" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,20"/>

                                <Button Content="Save to Database" Click="BtnSave_Click" Height="40" Background="#0F172A" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- RIGHT PANEL: 2x2 PRODUCT CATEGORY GRID -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- COFFEE -->
                            <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,10,15">
                                <StackPanel>
                                    <Border Background="#0F172A" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                        <TextBlock Text="☕ COFFEE" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <ItemsControl x:Name="CoffeeItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="ProductItem_Click" Tag="{Binding}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="#10B981" CornerRadius="10" Padding="8,2" Margin="10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="Available" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='₱{0:N2}'}" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        </Grid>
                                                        <Button Grid.Column="1" Content="❌" Click="BtnDelete_Click" Tag="{Binding ProductID}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- NON-COFFEE -->
                            <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="10,0,0,15">
                                <StackPanel>
                                    <Border Background="#0F172A" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                        <TextBlock Text="🥤 NON-COFFEE" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <ItemsControl x:Name="NonCoffeeItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="ProductItem_Click" Tag="{Binding}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="#10B981" CornerRadius="10" Padding="8,2" Margin="10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="Available" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='₱{0:N2}'}" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        </Grid>
                                                        <Button Grid.Column="1" Content="❌" Click="BtnDelete_Click" Tag="{Binding ProductID}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- TEA & MILK TEA -->
                            <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                                <StackPanel>
                                    <Border Background="#1E3A8A" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                        <TextBlock Text="🧋 TEA &amp; MILK TEA" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <ItemsControl x:Name="TeaItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="ProductItem_Click" Tag="{Binding}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="#10B981" CornerRadius="10" Padding="8,2" Margin="10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="Available" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='₱{0:N2}'}" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        </Grid>
                                                        <Button Grid.Column="1" Content="❌" Click="BtnDelete_Click" Tag="{Binding ProductID}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- CHOCOLATE -->
                            <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="10,0,0,0">
                                <StackPanel>
                                    <Border Background="#4A2511" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                        <TextBlock Text="🍫 CHOCOLATE" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <ItemsControl x:Name="ChocolateItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="ProductItem_Click" Tag="{Binding}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="#10B981" CornerRadius="10" Padding="8,2" Margin="10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="Available" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='₱{0:N2}'}" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        </Grid>
                                                        <Button Grid.Column="1" Content="❌" Click="BtnDelete_Click" Tag="{Binding ProductID}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: INGREDIENTS INVENTORY & STOCK CONTROL -->
            <TabItem Header="🌿 Ingredients Inventory &amp; Stock Control">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#0F172A" CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
                                <TextBlock Text="🌿 INGREDIENTS INVENTORY &amp; STOCK CONTROL" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            </Border>

                            <!-- SEARCH INGREDIENT -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Search Ingredient:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtSearchIngredient" Height="38" Padding="8,5" 
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtSearchIngredient_TextChanged"
                                         ToolTip="Type ingredient name to filter..."/>
                            </StackPanel>

                            <!-- ADD NEW INGREDIENT -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Add New Ingredient:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtNewIngredient" Grid.Column="0" Height="38" Padding="8,5" 
                                             VerticalContentAlignment="Center" Margin="0,0,10,0"
                                             ToolTip="New Ingredient Name"/>
                                    <TextBox x:Name="TxtInitialQuantity" Grid.Column="1" Height="38" Padding="8,5" 
                                             VerticalContentAlignment="Center" Margin="0,0,10,0" Text="5"
                                             ToolTip="Initial Stock"/>
                                    <Button Grid.Column="2" Content="+ Add Ingredient" Click="BtnAddIngredient_Click" 
                                            Height="38" Width="140" Background="#10B981" Foreground="White" 
                                            FontWeight="Bold" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>

                            <!-- LIST OF INGREDIENTS -->
                            <ItemsControl x:Name="IngredientsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                                CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- NAME & NUMBER OF STOCKS -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="• " Foreground="#0F172A" FontWeight="Bold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E293B" FontSize="15" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Quantity, StringFormat=' ({0} in stock)'}" FontWeight="SemiBold" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>

                                                <!-- STATUS BADGE -->
                                                <Border Grid.Column="1" CornerRadius="10" Padding="10,4" Margin="15,0" VerticalAlignment="Center" Background="{Binding StatusColor}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>

                                                <!-- INCREASE / DECREASE STOCKS -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Button Content=" - " Click="BtnDecreaseStock_Click" Tag="{Binding}" 
                                                            Width="30" Height="30" Background="#E2E8F0" Foreground="#0F172A" 
                                                            FontWeight="Bold" Cursor="Hand" Margin="0,0,5,0"/>
                                                    <Button Content=" + " Click="BtnIncreaseStock_Click" Tag="{Binding}" 
                                                            Width="30" Height="30" Background="#0F172A" Foreground="White" 
                                                            FontWeight="Bold" Cursor="Hand"/>
                                                </StackPanel>

                                                <!-- REMOVE INGREDIENT -->
                                                <Button Grid.Column="3" Content="❌" Click="BtnRemoveIngredient_Click" Tag="{Binding}" 
                                                        Foreground="#EF4444" Background="Transparent" BorderThickness="0" 
                                                        FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 3: EMPLOYEES -->
            <TabItem Header="👥 Employees">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="+ Add Employee" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                                <TextBlock Text="Employee Name" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtEmpName" Height="35" Padding="5" Margin="0,0,0,12"/>

                                <TextBlock Text="Contact Number" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtEmpContact" Height="35" Padding="5" Margin="0,0,0,12"/>

                                <TextBlock Text="Work Schedule" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtEmpSchedule" Height="35" Padding="5" Margin="0,0,0,12" Text="Morning (8AM-4PM)"/>

                                <TextBlock Text="Position" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbEmpPosition" Height="35" Padding="5" Margin="0,0,0,20" SelectedIndex="0">
                                    <ComboBoxItem Content="Cashier"/>
                                    <ComboBoxItem Content="Barista"/>
                                    <ComboBoxItem Content="Waiter"/>
                                </ComboBox>

                                <Button Content="Save Employee" Click="BtnSaveEmployee_Click" Height="40" Background="#0F172A" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                        <DataGrid x:Name="DgEmployees" AutoGenerateColumns="False" Background="White" RowHeight="38" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding EmployeeID}" Width="70"/>
                                <DataGridTextColumn Header="Name &amp; Position" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Contact Number" Binding="{Binding ContactNumber}" Width="180"/>
                                <DataGridTextColumn Header="Work Shift" Binding="{Binding WorkSchedule}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: SUPPLIER & DELIVERY -->
            <TabItem Header="🚚 Supplier &amp; Delivery">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.05" ShadowDepth="2"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="+ Add Supplier" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                                    <TextBlock Text="Company Name" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtCompanyName" Height="32" Padding="5" Margin="0,0,0,8"/>

                                    <TextBlock Text="Contact Person" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtContactPerson" Height="32" Padding="5" Margin="0,0,0,8"/>

                                    <TextBlock Text="Telephone Number" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtTelNumber" Height="32" Padding="5" Margin="0,0,0,8"/>

                                    <TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtEmail" Height="32" Padding="5" Margin="0,0,0,8"/>

                                    <TextBlock Text="Business Address" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtAddress" Height="32" Padding="5" Margin="0,0,0,15"/>

                                    <Button Content="Save Supplier" Click="BtnSaveSupplier_Click" Height="38" Background="#0F172A" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                                <DataGrid x:Name="DgSuppliers" AutoGenerateColumns="False" Background="White" RowHeight="34" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding SupplierID}" Width="50"/>
                                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="140"/>
                                        <DataGridTextColumn Header="Contact Person" Binding="{Binding ContactPerson}" Width="120"/>
                                        <DataGridTextColumn Header="Telephone" Binding="{Binding TelephoneNumber}" Width="110"/>
                                        <DataGridTextColumn Header="Email" Binding="{Binding EmailAddress}" Width="140"/>
                                        <DataGridTextColumn Header="Address" Binding="{Binding BusinessAddress}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <Border Background="White" CornerRadius="10" Padding="15">
                            <StackPanel>
                                <TextBlock Text="📦 Delivery Receipts &amp; Item Tracking" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                <DataGrid x:Name="DgDeliveries" AutoGenerateColumns="False" Background="White" Height="220" RowHeight="32" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Delivery ID" Binding="{Binding DeliveryID}" Width="90"/>
                                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="180"/>
                                        <DataGridTextColumn Header="Delivery Date" Binding="{Binding DeliveryDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="120"/>
                                        <DataGridTextColumn Header="Ingredient Received" Binding="{Binding IngredientName}" Width="*"/>
                                        <DataGridTextColumn Header="Qty Received" Binding="{Binding QuantityReceived}" Width="110"/>
                                        <DataGridTextColumn Header="Amount Paid" Binding="{Binding AmountPaid, StringFormat=₱\{0:N2\}}" Width="110"/>
                                        <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>